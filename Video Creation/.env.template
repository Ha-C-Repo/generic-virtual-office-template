# .env — Machine-specific configuration
# Your Company Video Studio
# DO NOT commit this file to git. Add .env to .gitignore.

# ── Runway ────────────────────────────────────────────────────────────────
RUNWAY_ACCOUNT=yourcompanyjoseph
RUNWAY_URL=https://app.runwayml.com
# RUNWAY_API_KEY=       # Only needed for API/endpoint Workflow publishing

# ── HyperFrames ──────────────────────────────────────────────────────────
HYPERFRAMES_OUTPUT_DIR=./src/shared_assets
HYPERFRAMES_DEFAULT_WIDTH=1920
HYPERFRAMES_DEFAULT_HEIGHT=1080
HYPERFRAMES_DEFAULT_FPS=30
HYPERFRAMES_DEFAULT_QUALITY=high

# ── Machine Mode (set manually per machine) ───────────────────────────────
# Override the auto-detection in orchestrate.js if needed.
# Options: RUNWAY_CHROME | HYPERFRAMES_LOCAL | HYBRID
# FORCE_ENGINE=HYBRID

# ── Shared Assets ─────────────────────────────────────────────────────────
SHARED_ASSETS_DIR=./src/shared_assets
MAX_ASSET_SIZE_MB=500

# ── Claude in Chrome MCP ─────────────────────────────────────────────────
# Device ID for iMac Chrome (Browser 1)
CHROME_DEVICE_ID_IMAC=1fccdbe4-40d3-41c6-9280-464992911154
# Device ID for Windows Chrome (set after first connection)
# CHROME_DEVICE_ID_WINDOWS=

# ── Project Settings ──────────────────────────────────────────────────────
STUDIO_NAME=Your Company Video Studio
EXECUTIVE_APPROVER=The Owner
PROJECT_COORDINATOR=Joseph Hasse
