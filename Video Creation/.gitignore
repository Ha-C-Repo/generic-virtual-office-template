# Node
node_modules/
npm-debug.log*

# Environment - never commit API keys
.env

# Large media files in shared_assets (commit only rendered finals)
src/shared_assets/*.mp4
src/shared_assets/*.mov
src/shared_assets/*.webm
src/shared_assets/*.wav
src/shared_assets/*.mp3

# Keep the rendered subfolder tracked (for reference)
!src/shared_assets/rendered/.gitkeep

# OS files
.DS_Store
._*
Thumbs.db

# HyperFrames temp
.hyperframes-cache/

# Per-machine engine routing cache (regenerated by orchestrate.js on each host)
.runway-route.json
